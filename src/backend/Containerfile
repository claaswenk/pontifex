FROM python:3.11.18-slim@sha256:07d4824036af339fa1b6ef769cc99d9c10a141769538b52b3b597c84f7a7b535

WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir --require-hashes -r requirements.txt \
    && pip uninstall -y setuptools wheel

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       apt=3.0.4 \
       libapt-pkg7.0=3.0.4 \
       openssl=3.5.7-1~deb13u3 \
       util-linux=2.41.5-0+deb13u1 \
       zlib1g=1:1.3.dfsg+really1.3.1-1+deb13u1 \
    && rm -rf /var/lib/apt/lists/*

COPY src/backend/run.py .
COPY src/backend/app/ ./app/
COPY src/shared/ ./shared/
COPY src/shared/entrypoint.sh /entrypoint.sh

RUN groupadd --system --gid 10001 app \
    && useradd --system --no-create-home --uid 10001 --gid 10001 app \
    && mkdir -p /app/certs /run/pontifex \
    && chown -R 10001:10001 /app/certs /run/pontifex \
    && chmod 700 /app/certs /run/pontifex \
    && chmod +x /entrypoint.sh

ENV PORT=7337 \
    TLS_CERT_PATH=/app/certs/tls.crt \
    TLS_KEY_PATH=/app/certs/tls.key

USER 10001:10001

EXPOSE 7337

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD ["python", "-c", "import urllib.request, ssl; urllib.request.urlopen('https://127.0.0.1:7337/api/health', timeout=2, context=ssl._create_unverified_context())"]

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "run.py"]

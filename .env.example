# -----------------------------------------------------------------------------
# Bootstrap key
# -----------------------------------------------------------------------------
INITIAL_API_KEY=


# -----------------------------------------------------------------------------
# Container identity key (per container)
# -----------------------------------------------------------------------------
CONTAINER_API_KEY=


# -----------------------------------------------------------------------------
# JWT signing secret
# -----------------------------------------------------------------------------
JWT_SECRET=


# -----------------------------------------------------------------------------
# TLS (HTTPS is mandatory)
# CERTS_DIR     directory on the HOST containing the certificate and key
#               (mounted read-only to /run/secrets in the container)
# TLS_CERT_PATH / TLS_KEY_PATH are paths INSIDE the container, so they must
# point below /run/secrets and use the file names found in CERTS_DIR.
# -----------------------------------------------------------------------------
CERTS_DIR=./certs
TLS_CERT_PATH=/run/secrets/tls.crt
TLS_KEY_PATH=/run/secrets/tls.key


# -----------------------------------------------------------------------------
# Server port (optional, default: 7337)
# -----------------------------------------------------------------------------
PORT=7337


# -----------------------------------------------------------------------------
# Frontend (HTTPS)
# FRONTEND_BIND_ADDRESS  host IP the frontend port is published on. Default
#                        127.0.0.1 (local only). To make it reachable from other
#                        machines, set the specific IP of the host interface
#                        (e.g. 192.168.1.10). Do not use 0.0.0.0.
# FRONTEND_PORT          published host port (container port is always 8443)
# TLS_EXTRA_SANS         extra names/IPs in the self-signed certificate so other
#                        devices can reach the frontend without a name mismatch,
#                        e.g. DNS:pontifex.local,IP:192.168.1.10
#                        Only applied when the certificate is generated, so
#                        delete the frontend_tls_certs volume to regenerate it.
# -----------------------------------------------------------------------------
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8443
TLS_EXTRA_SANS=


# -----------------------------------------------------------------------------
# Database (SQLite)
# Path inside the container where the .db file is stored.
# The directory is backed by the sqlite_data Docker volume.
# -----------------------------------------------------------------------------
DB_PATH=/app/data/pontifex.db

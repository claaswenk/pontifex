# scripts/init-env.sh (or .ps1) copies this file to .env and fills every empty
# secret below with a random value. Only change the rest if the defaults do not fit.

# Image version (default: latest). A release tag (v1.0.0), a commit tag
# (sha-<commit>) or a digest (latest@sha256:...) pins an exact version.
# PONTIFEX_TAG=latest

# --- Secrets (filled by init-env, never commit .env) ---------------------------

# One-time key that creates the first admin on the setup page.
INITIAL_API_KEY=
# Signs the access tokens of the backend.
JWT_SECRET=
# One secret per pair of containers (at least 32 characters). They are never
# sent over the wire; they only sign requests and answers.
BACKEND_FRONTEND_SECRET=
BACKEND_DATABASE_SECRET=

# --- Network -------------------------------------------------------------------

# Host IP the frontend is published on. Never 0.0.0.0. To reach it from another
# machine set the LAN IP of this host here and add the same IP or name to
# TLS_EXTRA_SANS (the certificate is created on the first start only).
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8443
TLS_EXTRA_SANS=
# The backend is for local use and for the frontend only.
BACKEND_BIND_ADDRESS=127.0.0.1
# The database has no published port: only the backend reaches it.

# Ports and addresses inside the compose network. Change them together.
PORT=7337
DATABASE_PORT=13110
BACKEND_URL=https://backend:7337
FRONTEND_URL=https://frontend:8443
DATABASE_URL=https://database:13110
# Where the SQLite file lives inside the database container.
DB_PATH=/app/data/pontifex.db

# Each container checks its peers at this interval (seconds). A mismatch of the
# secrets shows up in the logs of both sides.
PEER_CHECK_INTERVAL_SECONDS=30

# --- Wake-on-LAN ---------------------------------------------------------------

# A UDP broadcast from the container network never reaches the LAN, so the
# wake-relay container runs in the host network and sends the packets.
# WOL_BROADCAST is the broadcast address of your LAN: the "brd" value of
# `ip -4 -br addr` (e.g. 192.168.1.255). 255.255.255.255 works on many networks,
# the exact address is more reliable.
WOL_BROADCAST=255.255.255.255
WOL_PORT=9

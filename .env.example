# =============================================================================
# Pontifex - Environment Configuration Template
# =============================================================================
# IMPORTANT: This file is a TEMPLATE only.
# Copy to .env and fill in the actual values:
#   cp .env.example .env
#
# NEVER commit .env to Git! It contains secrets.
# Add .env to .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED: Container-to-Container Secrets (min 32 characters each)
# These secrets are used for mutual authentication between containers.
# They are NEVER sent over the wire - only used to sign requests/responses
# bound to the TLS certificate fingerprint.
# Generate with: openssl rand -base64 32 | tr -d '\n'
# -----------------------------------------------------------------------------
BACKEND_FRONTEND_SECRET=change_me_to_32_plus_random_chars
BACKEND_DATABASE_SECRET=change_me_to_32_plus_random_chars
JWT_SECRET=change_me_to_32_plus_random_chars

# -----------------------------------------------------------------------------
# REQUIRED: One-time Bootstrap Key
# Used only once to create the first admin user.
# After that, it is consumed and cannot be used again.
# -----------------------------------------------------------------------------
INITIAL_API_KEY=change_me_to_32_plus_random_chars

# -----------------------------------------------------------------------------
# OPTIONAL: Container-to-Container Configuration
# -----------------------------------------------------------------------------
# How often to check peer container authentication (default: 30 seconds)
PEER_CHECK_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# OPTIONAL: Backend Configuration
# -----------------------------------------------------------------------------
# Port for the backend service (default: 7337)
PORT=7337
# Path to the SQLite database file (inside container)
DB_PATH=/app/data/pontifex.db
# URL where the frontend can be reached (for peer monitoring)
FRONTEND_URL=https://frontend:8443

# -----------------------------------------------------------------------------
# OPTIONAL: Frontend Configuration
# -----------------------------------------------------------------------------
# Address and port for the frontend service
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8443
# URL where the backend can be reached (for peer monitoring)
BACKEND_URL=https://backend:7337
# Extra Subject Alternative Names for TLS certificate
TLS_EXTRA_SANS=

# -----------------------------------------------------------------------------
# OPTIONAL: Database Configuration
# -----------------------------------------------------------------------------
# Port for the database service (default: 13110)
DATABASE_PORT=13110
# URL where the database can be reached (for backend)
DATABASE_URL=https://database:13110

# -----------------------------------------------------------------------------
# OPTIONAL: TLS Configuration
# Paths to TLS certificate and key INSIDE the container.
# Defaults match the volume mounts in docker-compose.yml
# -----------------------------------------------------------------------------
TLS_CERT_PATH=/run/secrets/tls.crt
TLS_KEY_PATH=/run/secrets/tls.key

# -----------------------------------------------------------------------------
# OPTIONAL: Local Development - TLS Certificates Directory
# Path to directory containing tls.crt and tls.key on the HOST.
# This is used to mount certificates into containers.
# Default: ./certs
# -----------------------------------------------------------------------------
CERTS_DIR=./certs
